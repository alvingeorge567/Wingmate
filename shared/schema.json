{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Tone": { "enum": ["any", "playful", "flirty", "sincere", "curious"] },
    "SuggestRequest": {
      "type": "object",
      "required": ["messages"],
      "additionalProperties": false,
      "properties": {
        "messages": {
          "type": "array", "minItems": 1, "maxItems": 30,
          "items": {
            "type": "object", "required": ["from", "text"], "additionalProperties": false,
            "properties": {
              "from": { "enum": ["them", "me"] },
              "text": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        },
        "draft": { "type": "string", "maxLength": 1000 },
        "tone": { "$ref": "#/$defs/Tone" },
        "userProfile": { "type": "string", "maxLength": 500 },
        "count": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "SuggestResponse": {
      "type": "object",
      "required": ["suggestions", "read"],
      "properties": {
        "read": { "type": "string" },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object", "required": ["text", "tone"],
            "properties": {
              "text": { "type": "string" },
              "tone": { "enum": ["playful", "flirty", "sincere", "curious"] }
            }
          }
        }
      }
    }
  }
}
