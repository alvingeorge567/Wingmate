# Claude API key (server-side only, never shipped in the apps)
ANTHROPIC_API_KEY=sk-ant-...
# Shared token the keyboards send in X-App-Token. Generate a long random string.
APP_TOKEN=change-me
# Model used for suggestions. claude-sonnet-5-5 gives higher quality at higher cost/latency.
SUGGEST_MODEL=claude-haiku-5-5
# Requests per minute allowed per token+IP
RATE_LIMIT_PER_MIN=30
PORT=8787
